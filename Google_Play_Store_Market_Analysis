    "## 2. Data Cleaning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "2bb1834a",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-09-13T10:57:31.073048Z",
     "iopub.status.busy": "2026-09-13T10:57:31.072940Z",
     "iopub.status.idle": "2026-09-13T10:57:31.121373Z",
     "shell.execute_reply": "2026-09-13T10:57:31.120819Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cleaned apps shape: (9660, 16)\n",
      "Cleaned reviews shape: (30679, 5)\n"
     ]
    }
   ],
   "source": [
    "# Remove duplicate app names\n",
    "apps = apps.drop_duplicates(subset=[\"App\"], keep=\"first\").copy()\n",
    "\n",
    "# Convert numeric columns\n",
    "apps[\"Reviews\"] = pd.to_numeric(apps[\"Reviews\"], errors=\"coerce\")\n",
    "apps[\"Rating\"] = pd.to_numeric(apps[\"Rating\"], errors=\"coerce\")\n",
    "\n",
    "# Clean installs\n",
    "apps[\"Installs_num\"] = (\n",
    "    apps[\"Installs\"].astype(str)\n",
    "    .str.replace(\"+\", \"\", regex=False)\n",
    "    .str.replace(\",\", \"\", regex=False)\n",
    ")\n",
    "apps[\"Installs_num\"] = pd.to_numeric(apps[\"Installs_num\"], errors=\"coerce\")\n",
    "\n",
    "# Clean price\n",
    "apps[\"Price_num\"] = pd.to_numeric(\n",
    "    apps[\"Price\"].astype(str).str.replace(\"$\", \"\", regex=False),\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "\n",
    "# Clean size\n",
    "apps[\"Size_MB\"] = apps[\"Size\"].astype(str).replace(\"Varies with device\", np.nan)\n",
    "apps[\"Size_MB\"] = pd.to_numeric(\n",
    "    apps[\"Size_MB\"].str.replace(\"M\", \"\", regex=False).str.replace(\"k\", \"\", regex=False),\n",
    "    errors=\"coerce\"\n",
    ")\n",
    "apps.loc[apps[\"Size\"].astype(str).str.endswith(\"k\"), \"Size_MB\"] /= 1024\n",
    "\n",
    "# Convert date\n",
    "apps[\"Last Updated\"] = pd.to_datetime(apps[\"Last Updated\"], errors=\"coerce\")\n",
    "\n",
    "reviews = reviews.drop_duplicates().copy()\n",
    "\n",
    "print(\"Cleaned apps shape:\", apps.shape)\n",
    "print(\"Cleaned reviews shape:\", reviews.shape)\n"
   ]
  },
