    "df[\"YearMonth\"] = df[\"Date\"].dt.to_period(\"M\")\n",
    "df[\"Quarter\"] = df[\"Date\"].dt.to_period(\"Q\")\n",
    "\n",
    "bins = [0, 18, 25, 35, 45, 55, 100]\n",
    "labels = [\"0-18\", \"19-25\", \"26-35\", \"36-45\", \"46-55\", \"55+\"]\n",
    "df[\"Age_Group\"] = pd.cut(df[\"Age\"], bins=bins, labels=labels)\n",
